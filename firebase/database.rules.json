{
  "rules": {
    "agencies": { ".read": true, ".write": false },
    "routes": { ".read": true, ".write": false },
    "stops": {
      ".read": true,
      ".write": false,
      ".indexOn": ["name"],
      "$stopId": {
        "ratingSum": { ".write": "auth != null" },
        "ratingCount": { ".write": "auth != null" },
        "commentCount": { ".write": "auth != null" }
      }
    },
    "stopStats": {
      ".read": true,
      "$stopId": {
        "ratingSum": { ".write": "auth != null" },
        "ratingCount": { ".write": "auth != null" },
        "commentCount": { ".write": "auth != null" }
      }
    },
    "ratings": {
      ".read": true,
      "$targetType": { "$targetId": { "$userId": { ".write": "auth != null && auth.uid === $userId" } } }
    },
    "comments": {
      ".read": true,
      "$targetType": { "$targetId": { "$commentId": { ".write": "auth != null" } } }
    },
    "users": {
      ".read": true,
      "$userId": { ".write": "auth != null && auth.uid === $userId" }
    },
    "crowdsourced": {
      ".read": true,
      "$submissionId": { ".write": "auth != null" }
    },
    "leaderboard": {
      ".read": true,
      ".indexOn": ["points"],
      "$userId": { ".write": "auth != null && auth.uid === $userId" }
    },
    "activity": {
      ".read": true,
      "$stopId": {
        ".indexOn": ["timestamp"],
        "$pushId": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['uid', 'type', 'timestamp']) && newData.child('uid').val() === auth.uid"
        }
      }
    },
    "photos": {
      ".read": true,
      "$stopId": {
        ".indexOn": ["timestamp"],
        "$pushId": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['uid', 'data', 'timestamp']) && newData.child('uid').val() === auth.uid && newData.child('data').val().length < 200000"
        }
      }
    },
    "savedTrips": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId",
        "$tripId": {
          ".validate": "newData.hasChildren(['plan', 'createdAt']) && newData.child('plan').isString() && newData.child('plan').val().length < 65536"
        }
      }
    },
    "geofire": {
      ".read": true,
      ".write": false,
      "stops": { ".indexOn": ["g"] }
    },
    "meta": { ".read": true, ".write": false }
  }
}