<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Live turn-by-turn navigation: foreground service with location type (required
         API 34+) + notification. Started only while the app is in the foreground; no
         background-location permission is requested. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Hopper AI assistant: downloading the ~2 GB Gemma 4 model runs as a dataSync
         foreground service so it survives backgrounding (see AssistantDownloadService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- The LiteRT-LM runtime (Hopper AI assistant) declares minSdk 31; this app's minSdk
         is 26 by design (see app/build.gradle.kts). Every class from this library is loaded
         only behind an explicit SDK_INT >= 31 check (AssistantEngineFactory), so devices
         below 31 never touch it — this override is safe only because of that gate. -->
    <uses-sdk tools:overrideLibrary="com.google.ai.edge.litertlm" />

    <application
        android:name=".CrowdTransitApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CrowdTransit">
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.CrowdTransit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Shared trip deep links. Custom scheme is the reliable path (used by the
                 web viewer's intent:// button); the https filter is unverified (GitHub
                 project pages can't host assetlinks.json at the domain root) so it shows
                 the app chooser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="crowdtransit" android:host="trip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="chartmann1590.github.io"
                    android:pathPrefix="/crowdsource-transit/trip" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.NavigationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Hopper AI assistant: downloads the on-device Gemma 4 model (~2-2.6 GB). -->
        <service
            android:name=".service.AssistantDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Hopper AI assistant: keeps the app process foreground-priority while a
             message is generating. On-device CPU inference over an image can run well
             past a minute; without this, the process was observed getting killed by the
             system the moment the user briefly left the app (e.g. the system camera
             taking focus during "scan a stop sign"), silently losing the reply. -->
        <service
            android:name=".service.AssistantInferenceService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Full-resolution camera capture for "scan a stop sign" (multimodal Hopper
             tier only). Existing photo-upload flows use TakePicturePreview's thumbnail,
             which is too low-res to read text off a sign. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
